# Local development example only. Never use an owner URL in the hosted web process.
DATABASE_URL=postgresql://hms_runtime:CHANGE_ME@localhost:5432/hms_demo
JWT_SECRET=
JWT_EXPIRES_IN=8h
HMS_PUBLIC_DEMO=false
VITE_PUBLIC_DEMO=false
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
DEFAULT_LOCALE=ar
# Only the Neon cleanup Function receives a separate restricted cleanup login.
HMS_CLEANUP_DATABASE_URL=

# Leave empty until actual host proxy chain is measured. Never true, hop guesses or /0.
HMS_TRUSTED_PROXY_ADDRESSES=
